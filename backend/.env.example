# ─────────────────────────────────────────────────────────────────────────────
# EduCloud Backend — Environment Variables
# Copy this file to .env for local dev. Set these in the Render dashboard
# for production. NEVER commit .env with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your exact Vercel frontend URL
FRONTEND_URL=https://educloud-frontend-one.vercel.app

# ── AWS Credentials (use an IAM user with least privilege) ───────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# ── Amazon Cognito ────────────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
# Set to "true" only in dev to skip email verification
AUTO_CONFIRM=false

# ── DynamoDB Table Names ──────────────────────────────────────────────────────
USERS_TABLE=EduCloud-Users
ASSIGNMENTS_TABLE=EduCloud-Assignments
SUBMISSIONS_TABLE=EduCloud-Submissions

# ── S3 Bucket ─────────────────────────────────────────────────────────────────
S3_BUCKET=educloud-assignments-bucket
