{
  "name": "educloud-backend",
  "version": "1.0.0",
  "description": "EduCloud Assignment Management System — Backend Lambda Functions",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:unit": "jest tests/unit --forceExit",
    "test:integration": "jest tests/integration --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "eslint src/**/*.js tests/**/*.js",
    "build": "echo 'No build step needed for Lambda'"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.438.0",
    "@aws-sdk/client-dynamodb": "^3.438.0",
    "@aws-sdk/client-s3": "^3.438.0",
    "@aws-sdk/lib-dynamodb": "^3.438.0",
    "@aws-sdk/s3-request-presigner": "^3.438.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "aws-sdk-client-mock": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.438.0",
    "eslint": "^8.52.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js"],
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
